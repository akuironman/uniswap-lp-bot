# === Telegram Bot ===
TELEGRAM_TOKEN=123456789:***
# Optional: batasi bot ke chat_id tertentu (comma-separated). Kosong = bebas.
ALLOWED_CHAT_IDS=
# Optional: chat_id untuk push notif otomatis (biasanya chat_id kamu sendiri)
NOTIFY_CHAT_ID=

# === Robinhood Chain (chainId 4663, native = ETH) ===
# Bot ini KHUSUS Robinhood Chain — tidak multi-chain.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# === Wallet ===
# Dry-run = kosongin (bot tetap simulasi walaupun DRY_RUN=false).
PRIVATE_KEY=
WALLET_ADDRESS=

# === Uniswap V3 contracts di Robinhood Chain ===
# WETH sudah terverifikasi dari pair Uniswap V3 real di DexScreener.
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# NPM (NonfungiblePositionManager) & SwapRouter — WAJIB isi manual untuk LIVE.
# Cari di block explorer: https://robinhoodchain.blockscout.com
# → cari kontrak Uniswap V3 yang di-deploy Uniswap Labs.
# Kalau kosong, bot otomatis skip live (fallback dry-run) — aman.
NPM_ADDRESS=
SWAP_ROUTER_ADDRESS=

# === Trading mode ===
# true  = DRY-RUN (simulasi, tidak nyentuh chain) — AMAN, default
# false = LIVE (broadcast tx on-chain) — butuh PRIVATE_KEY + NPM + SwapRouter di atas
# Bot tetap dry-run kalau PRIVATE_KEY / NPM / SwapRouter kosong.
DRY_RUN=true

# === Screening (Yunus filters) ===
# Default longgar untuk Robinhood chain (mostly microcap).
MIN_MARKET_CAP=50000
MIN_AGE_HOURS=6
MAX_AGE_HOURS=72
MIN_VOLUME_24H=50000
MIN_LIQUIDITY_USD=10000
MIN_HOLDERS=200

# === LP strategy ===
# Sizing per posisi. Rekomendasi Robinhood: pakai POSITION_SIZE_ETH langsung
# (wallet-mu native ETH, tidak perlu oracle harga).
POSITION_SIZE_USD=200
# Kalau > 0, override POSITION_SIZE_USD dan pakai jumlah ETH ini apa adanya.
# Contoh: 0.05 → tiap posisi swap 0.05 ETH ke target token, lalu LP.
POSITION_SIZE_ETH=0
MAX_ACTIVE_POSITIONS=3
FEE_TIER=3000
RANGE_WIDTH_PCT=15
AUTO_REBALANCE=true
TAKE_PROFIT_PCT=30
STOP_LOSS_PCT=25
# Slippage tolerance saat swap ETH → target (basis points, 200 = 2%)
SWAP_SLIPPAGE_BPS=200

# === Loop ===
SCAN_INTERVAL_SEC=60

# === Web dashboard ===
DASHBOARD_ENABLED=true
HOST=0.0.0.0
PORT=8080
# Optional: public URL untuk tombol "DASHBOARD" di menu Telegram (ngrok/tailscale/domain).
# Kosongin kalau akses cuma dari localhost (localhost gak bisa diklik dari HP).
DASHBOARD_PUBLIC_URL=

# === Data sources ===
DEXSCREENER_API=https://api.dexscreener.com
