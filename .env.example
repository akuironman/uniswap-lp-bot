# === Telegram Bot ===
TELEGRAM_TOKEN=123456789:AA_your_bot_token_from_botfather
# Optional: batasi bot ke chat_id tertentu (comma-separated). Kosong = bebas.
ALLOWED_CHAT_IDS=
# Optional: chat_id untuk push notif otomatis (biasanya chat_id kamu sendiri)
NOTIFY_CHAT_ID=

# === RPC ===
RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org

# === Wallet (dry-run = kosongin) ===
PRIVATE_KEY=
WALLET_ADDRESS=

# === Uniswap V3 ===
NPM_ADDRESS=0xC36442b4a4522E871399CD717aBDD847Ab11FE88

# === Screening (Yunus filters) ===
MIN_MARKET_CAP=50000
MIN_AGE_HOURS=6
MAX_AGE_HOURS=72
MIN_VOLUME_24H=50000
MIN_LIQUIDITY_USD=10000
MIN_HOLDERS=200

# === Trading mode ===
# true  = DRY-RUN (simulasi, tidak nyentuh chain) — AMAN, default
# false = LIVE (broadcast transaksi on-chain sungguhan) — butuh PRIVATE_KEY + wallet berdana
# Ganti nilai ini buat pindah mode. Bot tetap dry-run kalau PRIVATE_KEY kosong.
DRY_RUN=true

# === LP strategy ===
POSITION_SIZE_USD=200
MAX_ACTIVE_POSITIONS=3
FEE_TIER=3000
RANGE_WIDTH_PCT=15
AUTO_REBALANCE=true
TAKE_PROFIT_PCT=30
STOP_LOSS_PCT=25

# === Loop ===
SCAN_INTERVAL_SEC=60

# === Web dashboard ===
DASHBOARD_ENABLED=true
HOST=0.0.0.0
PORT=8080
# Optional: public URL for the Telegram "DASHBOARD" button (ngrok/tailscale/domain).
# Kosongin kalau akses dashboard cuma dari localhost (localhost gak bisa diklik dari HP).
DASHBOARD_PUBLIC_URL=

# === Data sources ===
DEXSCREENER_API=https://api.dexscreener.com
